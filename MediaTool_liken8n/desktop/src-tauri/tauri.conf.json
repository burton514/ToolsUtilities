{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MediaTool",
  "version": "0.1.0",
  "identifier": "dev.mediatool.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../sandbox/dist",
    "beforeDevCommand": "npm run dev -w sandbox",
    "beforeBuildCommand": "npm run build -w sandbox"
  },
  "app": {
    "windows": [{ "title": "MediaTool", "width": 1360, "height": 860, "minWidth": 900, "minHeight": 600 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" }
}
